<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #00aeee;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ViewDoctorsController">
