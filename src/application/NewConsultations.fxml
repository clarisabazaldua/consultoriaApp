<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #00aeee;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.NewConsultationController">
   <children>
      <MenuBar prefHeight="29.0" prefWidth="600.0">
        <menus>
          <Menu mnemonicParsing="false" text="Return">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#mItemReturnToHomePageClicked" text="Return to Home Page" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="309.0" layoutX="20.0" layoutY="79.0" stroke="WHITE" strokeType="INSIDE" width="554.0" />
      <Label layoutX="29.0" layoutY="33.0" text="New Consultation " textFill="WHITE">
         <font>
            <Font name="Avenir Next Condensed Medium" size="28.0" />
         </font>
      </Label>
      <Separator layoutX="23.0" layoutY="70.0" prefHeight="2.0" prefWidth="554.0" />
      <TableView fx:id="tablePatients" layoutX="20.0" layoutY="119.0" onMouseClicked="#tablePatientsOnMouseClicked" prefHeight="269.0" prefWidth="223.0">
        <columns>
          <TableColumn fx:id="colName" prefWidth="111.0" text="Name " />
          <TableColumn fx:id="conDiagnosis" prefWidth="113.0" text="Diagnosis" />
        </columns>
      </TableView>
      <TextField fx:id="txtSearch" layoutX="73.0" layoutY="81.0" prefHeight="27.0" prefWidth="216.0" />
      <Label layoutX="29.0" layoutY="86.0" text="Name:" />
      <Label fx:id="lblName" layoutX="262.0" layoutY="119.0" prefHeight="17.0" prefWidth="206.0" text="Name:">
         <font>
            <Font size="14.0" />
         </font></Label>
      <DatePicker fx:id="datePickerConsultationDate" layoutX="312.0" layoutY="142.0" prefHeight="27.0" prefWidth="138.0" promptText="XX/XX/XXXX" />
      <Label layoutX="277.0" layoutY="147.0" text="Date:" />
      <Label layoutX="276.0" layoutY="176.0" text="Time:" />
      <TextField fx:id="txtConsultationTime" layoutX="312.0" layoutY="171.0" promptText="XX:XX" />
      <Label layoutX="255.0" layoutY="209.0" prefHeight="17.0" prefWidth="73.0" text="Hospital:" />
      <ComboBox fx:id="cboHospital" layoutX="315.0" layoutY="204.0" prefHeight="27.0" prefWidth="154.0" />
      <Button layoutX="292.0" layoutY="331.0" mnemonicParsing="false" onAction="#btnCreateClicked" prefHeight="27.0" prefWidth="73.0" text="Create" />
      <Button layoutX="409.0" layoutY="331.0" mnemonicParsing="false" onAction="#btnCancelClicked" prefHeight="27.0" prefWidth="81.0" text="Cancel" />
      <ImageView fx:id="imgHospitals" fitHeight="82.0" fitWidth="263.0" layoutX="267.0" layoutY="233.0" pickOnBounds="true" preserveRatio="true" />
      <Button layoutX="287.0" layoutY="81.0" mnemonicParsing="false" onAction="#btnSearchOnClicked" text="Search" />
   </children>
</AnchorPane>
