<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #00aeee;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ViewConsultationsController">
   <children>
      <MenuBar prefHeight="29.0" prefWidth="600.0">
        <menus>
          <Menu mnemonicParsing="false" onAction="#mItemReturnToHomePageClicked" text="Return">
            <items>
              <MenuItem mnemonicParsing="false" text="Return to Home Page" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <Label layoutX="22.0" layoutY="35.0" text="View Consultations" textFill="WHITE">
         <font>
            <Font name="Avenir Next Condensed Medium" size="28.0" />
         </font>
      </Label>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="313.0" layoutX="6.0" layoutY="77.0" stroke="WHITE" strokeType="INSIDE" width="588.0" />
      <Separator layoutX="22.0" layoutY="68.0" prefHeight="9.0" prefWidth="555.0" />
      <Label layoutX="13.0" layoutY="82.0" text="Name:" />
      <Button layoutX="506.0" layoutY="77.0" mnemonicParsing="false" onAction="#btnSearch" text="Search" />
      <TextField fx:id="txtSearchName" layoutX="54.0" layoutY="77.0" prefHeight="27.0" prefWidth="184.0" />
      <TableView fx:id="tableConsultations" layoutX="22.0" layoutY="113.0" onMouseClicked="#tableConsultationsOnMouseClicked" prefHeight="200.0" prefWidth="555.0">
        <columns>
          <TableColumn fx:id="colName" prefWidth="179.0" text="Name" />
            <TableColumn fx:id="colDate" prefWidth="129.0" text="Date " />
            <TableColumn fx:id="colTime" prefWidth="89.0" text="Time" />
            <TableColumn fx:id="colHospital" prefWidth="157.0" text="Hospital" />
        </columns>
      </TableView>
      <Label fx:id="lblName" layoutX="13.0" layoutY="327.0" text="Name:" />
      <Label layoutX="144.0" layoutY="327.0" text="Date:" />
      <Label layoutX="311.0" layoutY="327.0" text="Time:" />
      <TextField fx:id="txtTime" layoutX="346.0" layoutY="322.0" prefHeight="27.0" prefWidth="107.0" promptText="XX:XX" />
      <ComboBox fx:id="cboHospital" layoutX="465.0" layoutY="322.0" prefHeight="27.0" prefWidth="121.0" promptText="Hospital" />
      <Button layoutX="97.0" layoutY="359.0" mnemonicParsing="false" onAction="#btnUpdate" prefHeight="27.0" prefWidth="165.0" text="Update" />
      <Button layoutX="311.0" layoutY="359.0" mnemonicParsing="false" onAction="#btnDelete" prefHeight="27.0" prefWidth="176.0" text="Delete" />
      <DatePicker fx:id="datePickerDate" layoutX="176.0" layoutY="322.0" prefHeight="27.0" prefWidth="121.0" promptText="XX/XX/XXXX" />
      <Label layoutX="244.0" layoutY="82.0" text="Date:" />
      <DatePicker fx:id="dpDateSearch" layoutX="277.0" layoutY="77.0" />
   </children>
</AnchorPane>
