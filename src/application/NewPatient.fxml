                        <Button fx:id="btnPlusDoctors" layoutX="232.0" layoutY="157.0" mnemonicParsing="false" onAction="#btnPlusDoctorsClick" prefHeight="27.0" prefWidth="28.0" text="+" />
                        <Button fx:id="btnAddDoctor" layoutX="460.0" layoutY="156.0" mnemonicParsing="false" onAction="#btnAddDoctorClick" prefHeight="27.0" prefWidth="62.0" text="Add" />
                        <TextField fx:id="txtAddDoctor" layoutX="264.0" layoutY="159.0" prefHeight="21.0" prefWidth="187.0">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </TextField>
                        <Label layoutX="39.0" layoutY="240.0" text="Occupation*:" />
                        <TextArea fx:id="txtOccupation" layoutX="28.0" layoutY="257.0" prefHeight="57.0" prefWidth="263.0" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Medical History ">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="363.0" prefWidth="600.0">
                     <children>
                        <Separator layoutX="16.0" layoutY="38.0" prefHeight="4.0" prefWidth="568.0" />
                        <Label layoutX="25.0" text="New Patient" textFill="WHITE">
                           <font>
                              <Font name="Avenir Next Condensed Medium" size="28.0" />
                           </font>
                        </Label>
                        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="283.0" layoutX="10.0" layoutY="45.0" stroke="WHITE" strokeType="INSIDE" width="580.0" />
                        <Label layoutX="29.0" layoutY="55.0" text="Height*:" />
                        <TextField fx:id="txtHeight" layoutX="72.0" layoutY="54.0" prefHeight="21.0" prefWidth="47.0">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </TextField>
                        <Label layoutX="124.0" layoutY="55.0" text="cm" />
                        <Label layoutX="166.0" layoutY="55.0" text="Weight*:" />
                        <TextField fx:id="txtWeight" layoutX="213.0" layoutY="54.0" prefHeight="21.0" prefWidth="47.0">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </TextField>
                        <Label layoutX="265.0" layoutY="56.0" text="kg" />
                        <Label layoutX="39.0" layoutY="84.0" prefHeight="17.0" prefWidth="65.0" text="Alergies*:" />
                        <TextArea fx:id="txtAlergies" layoutX="42.0" layoutY="106.0" prefHeight="51.0" prefWidth="239.0" />
                        <Label layoutX="28.0" layoutY="160.0" prefHeight="17.0" prefWidth="157.0" text="Notes*:" />
                        <TextArea fx:id="txtPastMedicalProc" layoutX="48.0" layoutY="183.0" prefHeight="85.0" prefWidth="234.0" />
                        <Label layoutX="316.0" layoutY="56.0" prefHeight="17.0" prefWidth="153.0" text="Current diagnosis:" />
                        <TextArea fx:id="txtDiagnosis" layoutX="325.0" layoutY="77.0" prefHeight="82.0" prefWidth="239.0" />
                        <Label layoutX="319.0" layoutY="169.0" prefHeight="17.0" prefWidth="153.0" text="Current prescription:" />
                        <TextArea fx:id="txtPrescription" layoutX="312.0" layoutY="185.0" prefHeight="82.0" prefWidth="239.0" />
                        <Button layoutX="164.0" layoutY="286.0" mnemonicParsing="false" onAction="#btnAddNewPatientClick" prefHeight="27.0" prefWidth="96.0" text="Add Patient" />
                        <Button layoutX="312.0" layoutY="287.0" mnemonicParsing="false" onAction="#btnCancelNewPatientClick" prefHeight="27.0" prefWidth="96.0" text="Cancel " />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
